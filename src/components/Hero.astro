---
import { SITE, NAV_LINKS } from '@lib/consts';
---

<section class="section-container section-padding flex flex-col items-center text-center">
  <!-- Slogan -->
  <h1
    class="font-serif text-4xl sm:text-5xl lg:text-6xl font-black text-warm-900
           leading-tight tracking-tight text-balance opacity-0 animate-fade-in-up"
  >
    {SITE.title}
  </h1>

  <!-- Subtitle -->
  <p
    class="mt-6 max-w-lg text-lg sm:text-xl text-warm-800/60 leading-relaxed
           opacity-0 animate-fade-in-up"
    style="animation-delay: 0.15s"
  >
    {SITE.description}
  </p>

  <!-- CTA Buttons -->
  <div
    class="mt-10 flex flex-wrap items-center justify-center gap-4
           opacity-0 animate-fade-in-up"
    style="animation-delay: 0.3s"
  >
    <a
      href="/blog"
      class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-2.5
             text-sm font-medium text-white shadow-sm
             transition-all duration-200 hover:bg-accent-hover hover:shadow-md"
    >
      读博客
    </a>
    <a
      href="/projects"
      class="inline-flex items-center gap-2 rounded-full border border-warm-300 px-6 py-2.5
             text-sm font-medium text-warm-800/70
             transition-all duration-200 hover:border-accent hover:text-accent"
    >
      看项目
    </a>
    <a
      href="/about"
      class="inline-flex items-center gap-2 rounded-full px-6 py-2.5
             text-sm font-medium text-warm-800/50
             transition-all duration-200 hover:text-accent"
    >
      关于我
    </a>
  </div>

  <!-- Scroll hint -->
  <div class="mt-16 animate-bounce">
    <svg
      class="h-5 w-5 text-warm-300"
      fill="none" stroke="currentColor" stroke-width="2"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </div>
</section>
