---
import type { CollectionEntry } from 'astro:content';
import { CATEGORY_LABELS } from '@lib/consts';
import { readingTime } from '@lib/readingTime';
import { formatDate } from '@lib/formatDate';

export interface Props {
  post: CollectionEntry<'blog'>;
  /** 最多显示几个标签，默认 2 */
  maxTags?: number;
}

const { post, maxTags = 2 } = Astro.props;
const categoryLabel = post.data.category ? CATEGORY_LABELS[post.data.category] : null;
const minutes = readingTime(post.body);
---

<a
  href={`/blog/${post.slug}`}
  class="group flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6
         rounded-xl px-4 py-4 -mx-4
         transition-colors duration-150 hover:bg-warm-100"
>
  <time
    class="shrink-0 text-sm text-warm-800/40 tabular-nums"
    datetime={post.data.pubDate.toISOString()}
  >
    {formatDate(post.data.pubDate)}
  </time>

  <div class="flex-1 min-w-0">
    <span class="font-medium text-warm-800 group-hover:text-accent transition-colors leading-snug">
      {post.data.title}
    </span>
  </div>

  <div class="flex items-center gap-2 shrink-0 flex-wrap">
    {categoryLabel && (
      <span class="text-xs text-accent bg-accent-light/40 px-2 py-0.5 rounded-full">
        {categoryLabel}
      </span>
    )}
    {
      post.data.tags.slice(0, maxTags).map((tag) => (
        <span class="text-xs text-warm-800/30 bg-warm-200/50 px-2 py-0.5 rounded-full">
          {tag}
        </span>
      ))
    }
    <span class="text-xs text-warm-800/30 whitespace-nowrap">
      约 {minutes} 分钟
    </span>
  </div>
</a>
