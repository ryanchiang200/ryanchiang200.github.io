---
import { SITE, NAV_LINKS, SOCIAL_LINKS } from '@lib/consts';
import { ViewTransitions } from 'astro:transitions';
import Seo from '@components/Seo.astro';
import '@styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  /** SEO 附加信息，传给 Seo 组件 */
  seo?: Record<string, any>;
  /** 禁止收录（隐藏页） */
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  seo = {},
  noindex = false,
} = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <ViewTransitions />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <Seo title={title} description={description} noindex={noindex} {...seo} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Font: Noto Serif SC -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;700;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Header -->
    <header class="section-container w-full py-6">
      <nav class="flex items-center justify-between">
        <a
          href="/"
          class="font-serif text-xl font-bold text-warm-900 tracking-tight hover:text-accent transition-colors"
        >
          R
        </a>
        <ul class="hidden sm:flex items-center gap-8">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a href={link.href} class="nav-link text-sm font-medium tracking-wide">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <!-- Mobile placeholder: simple menu link -->
        <a
          href="/blog"
          class="sm:hidden nav-link text-sm font-medium"
        >
          菜单
        </a>
      </nav>
    </header>

    <!-- Main content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="section-container w-full py-10 mt-20 border-t border-warm-200">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-warm-800/50">
        <p>&copy; {SITE.since} — {new Date().getFullYear()} {SITE.author}</p>
        <div class="flex items-center gap-6">
          {
            SOCIAL_LINKS.map((link) => (
              <a
                href={link.href}
                class="hover:text-accent transition-colors"
                target="_blank"
                rel="noopener noreferrer"
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
    </footer>
  </body>
</html>
