---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到">
  <section class="section-container section-padding flex flex-col items-center text-center">
    <p class="font-serif text-8xl font-black text-warm-200">404</p>
    <h1 class="mt-6 font-serif text-2xl font-bold text-warm-900">
      页面未找到
    </h1>
    <p class="mt-3 text-warm-800/50">
      你要找的页面不存在，或者已经被移走了。
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 rounded-full bg-accent px-6 py-2.5
             text-sm font-medium text-white shadow-sm
             transition-all duration-200 hover:bg-accent-hover"
    >
      ← 返回首页
    </a>
  </section>
</BaseLayout>
