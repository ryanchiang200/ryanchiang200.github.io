---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PostListItem from '@components/PostListItem.astro';
import CategoryNav from '@components/CategoryNav.astro';
import { CATEGORY_LABELS } from '@lib/consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return Object.keys(CATEGORY_LABELS).map((category) => ({
    params: { category },
    props: {
      category,
      posts: posts
        .filter((p) => p.data.category === category)
        .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()),
    },
  }));
}

type Props = {
  category: string;
  posts: CollectionEntry<'blog'>[];
};

const { category, posts } = Astro.props;
const label = CATEGORY_LABELS[category] ?? category;
---

<BaseLayout title={`${label} · 博客`}>
  <section class="section-container section-padding">
    <h1 class="font-serif text-3xl sm:text-4xl font-black text-warm-900">
      {label}
    </h1>
    <p class="mt-3 text-warm-800/50">
      分类 · {label} · 共 {posts.length} 篇
    </p>

    <div class="mt-8">
      <CategoryNav current={category} />
    </div>

    {
      posts.length === 0 ? (
        <div class="card mt-10 text-center py-16">
          <p class="text-warm-800/40">该分类还没有文章，稍后再来 ✨</p>
        </div>
      ) : (
        <div class="mt-10 space-y-1">
          {posts.map((post) => <PostListItem post={post} />)}
        </div>
      )
    }

    <footer class="mt-12 pt-8 border-t border-warm-200">
      <a href="/blog" class="nav-link text-sm">
        ← 全部博客
      </a>
    </footer>
  </section>
</BaseLayout>
