---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<BaseLayout title="博客">
  <section class="section-container section-padding">
    <h1 class="font-serif text-3xl sm:text-4xl font-black text-warm-900">
      博客
    </h1>
    <p class="mt-3 text-warm-800/50">
      技术 · 登山 · 随笔
    </p>

    {
      posts.length === 0 ? (
        <div class="card mt-12 text-center py-16">
          <p class="text-warm-800/40">还没有文章，稍后再来 ✨</p>
        </div>
      ) : (
        <div class="mt-12 space-y-1">
          {posts.map((post) => (
            <a
              href={`/blog/${post.slug}`}
              class="group flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6
                     rounded-xl px-4 py-4 -mx-4
                     transition-colors duration-150 hover:bg-warm-100"
            >
              <time
                class="shrink-0 text-sm text-warm-800/40 tabular-nums"
                datetime={post.data.pubDate.toISOString()}
              >
                {post.data.pubDate.toLocaleDateString('zh-CN', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
              <div class="flex-1">
                <span class="font-medium text-warm-800 group-hover:text-accent transition-colors leading-snug">
                  {post.data.title}
                </span>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                {post.data.tags?.map((tag: string) => (
                  <span class="text-xs text-warm-800/30 bg-warm-200/50 px-2 py-0.5 rounded-full">
                    {tag}
                  </span>
                ))}
              </div>
            </a>
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
