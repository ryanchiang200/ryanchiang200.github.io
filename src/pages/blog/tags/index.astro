---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);

// 统计每个标签的文章数
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}

// 按文章数降序，其次按标签名
const tags = [...tagCounts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-CN')
);
---

<BaseLayout title="标签">
  <section class="section-container section-padding">
    <h1 class="font-serif text-3xl sm:text-4xl font-black text-warm-900">
      标签
    </h1>
    <p class="mt-3 text-warm-800/50">
      按主题浏览文章
    </p>

    {
      tags.length === 0 ? (
        <div class="card mt-12 text-center py-16">
          <p class="text-warm-800/40">还没有标签 ✨</p>
        </div>
      ) : (
        <div class="mt-12 flex flex-wrap gap-3">
          {
            tags.map(([tag, count]) => (
              <a
                href={`/blog/tags/${encodeURIComponent(tag)}`}
                class="inline-flex items-center gap-2 rounded-full border border-warm-200
                       bg-warm-100 px-4 py-1.5 text-sm text-warm-800/70
                       transition-all duration-200 hover:border-accent hover:text-accent"
              >
                {tag}
                <span class="text-xs text-warm-800/40 tabular-nums">({count})</span>
              </a>
            ))
          }
        </div>
      )
    }
  </section>
</BaseLayout>
