---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PostListItem from '@components/PostListItem.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tagMap = new Map<string, CollectionEntry<'blog'>[]>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const list = tagMap.get(tag) ?? [];
      list.push(post);
      tagMap.set(tag, list);
    }
  }
  return [...tagMap.entries()].map(([tag, tagPosts]) => ({
    params: { tag },
    props: {
      tag,
      posts: tagPosts.sort(
        (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
      ),
    },
  }));
}

type Props = {
  tag: string;
  posts: CollectionEntry<'blog'>[];
};

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag}`}>
  <section class="section-container section-padding">
    <a
      href="/blog/tags"
      class="nav-link text-sm"
    >
      ← 所有标签
    </a>

    <h1 class="mt-6 font-serif text-3xl sm:text-4xl font-black text-warm-900">
      {tag}
    </h1>
    <p class="mt-3 text-warm-800/50">
      {posts.length} 篇文章
    </p>

    <div class="mt-12 space-y-1">
      {posts.map((post) => <PostListItem post={post} />)}
    </div>
  </section>
</BaseLayout>
