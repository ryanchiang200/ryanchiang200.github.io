---
import BaseLayout from '@layouts/BaseLayout.astro';
import SearchBox from '@components/SearchBox';
---

<BaseLayout title="搜索">
  <section class="section-container section-padding">
    <h1 class="font-serif text-3xl sm:text-4xl font-black text-warm-900">
      搜索
    </h1>
    <p class="mt-3 text-warm-800/50">
      输入关键词搜索文章标题、描述与标签
    </p>

    <div class="mt-10">
      <SearchBox client:load />
    </div>
  </section>
</BaseLayout>
